# Copy this file to .env and fill in real values.
# Never commit .env — it is already in .gitignore.

# --- AI reasoning provider (Anthropic) ---
ANTHROPIC_API_KEY=

# Model identifier only — changing models must never require code changes.
# See docs/DECISIONS.md for why this default was chosen and how to change it.
ANTHROPIC_MODEL=claude-opus-5

# Reasoning depth, kept independent from the model identifier.
# One of: low, medium, high, xhigh, max
ANTHROPIC_EFFORT=medium

# --- Market data provider (Twelve Data) ---
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# --- Economic calendar provider (Finnhub, Mission 7 research data layer) ---
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# --- Voice STT/TTS provider (Deepgram Nova-3/Aura-2, Mission 9 Phase 2) ---
# Header-based auth (Authorization: Token ...) -- Deepgram's API host is
# hardcoded in orion.voice.deepgram_stt/deepgram_tts, so no base URL setting
# exists here (unlike Twelve Data/Finnhub).
DEEPGRAM_API_KEY=

# --- Decision memory (local SQLite, no external DB in this milestone) ---
ORION_DB_PATH=./orion.db

# --- Risk Guardian ---
# Fail-safe default: engaged (blocking). An absent or misconfigured switch
# must never silently permit trading — set to "disengaged" only deliberately.
# One of: engaged, disengaged
ORION_KILL_SWITCH=engaged

# How many bars old Evidence may be before the Risk Guardian vetoes on
# staleness (re-checked after the reasoning round-trip, independent of the
# staleness check already done at data-fetch time). Shares its default with
# orion.data.validation's own staleness threshold.
ORION_MAX_STALENESS_BARS=3.0

# How many bars old a ProposedDecision itself may be before the Risk Guardian
# treats it as expired — distinct from evidence staleness above.
ORION_MAX_DECISION_AGE_BARS=1.0

# Minimum acceptable risk/reward ratio for a trade proposal. 1.0 is a
# mathematically justified floor (below it, breakeven needs a win rate over
# 50%), not an empirically validated trading-strategy parameter — raising it
# requires real historical validation, not just a stated preference.
ORION_MIN_RISK_REWARD=1.0

# Off by default: the ATR% volatility thresholds in orion.analysis.structure
# are documented as uncalibrated placeholders, so blocking HIGH volatility by
# default would veto most higher-timeframe proposals using a number nobody
# calibrated. Set true only as a deliberate, recorded policy choice.
ORION_BLOCK_HIGH_VOLATILITY=false

# --- Risk Guardian: Mission 4 portfolio-state-dependent limits ---
# Conventional engineering starting points, not empirically calibrated to
# XAUUSD. See docs/DECISIONS.md (Mission 4 architecture entry) and
# orion.risk.policy.RiskPolicy.

# Fraction of equity risked on a single trade's stop distance.
ORION_MAX_RISK_PER_TRADE=0.01

# Fraction of equity the one open position's notional value may reach.
ORION_MAX_EXPOSURE=1.0

# Fraction of the UTC day's opening equity that may be lost before the
# Risk Guardian vetoes further trades for the rest of that day.
ORION_MAX_DAILY_LOSS=0.03

# Fraction of the UTC week's opening equity that may be lost before the
# Risk Guardian vetoes further trades for the rest of that week.
ORION_MAX_WEEKLY_LOSS=0.08

# Fraction drop from the all-time equity high-water mark before the Risk
# Guardian vetoes further trades.
ORION_MAX_DRAWDOWN=0.15

# How many bars old a PortfolioState may be before the Risk Guardian treats
# it as too stale to evaluate a trade against — same figure/reasoning as
# ORION_MAX_STALENESS_BARS, applied to portfolio state instead of evidence.
ORION_MAX_PORTFOLIO_STALENESS_BARS=3.0

# --- Paper Trading (Mission 4) ---
# Deterministic simulated-execution parameters only — never a risk limit.
# See orion.paper.policy.PaperExecutionPolicy.

# Starting cash balance for a freshly-initialized paper account.
PAPER_STARTING_BALANCE=10000.0

# Simulated bid/ask spread, in basis points (1 bps = 0.01%), applied against
# the reference price on every fill.
PAPER_SPREAD_BPS=2.0

# Simulated slippage, in basis points, applied on top of spread on every
# fill. Deterministic — never randomized.
PAPER_SLIPPAGE_BPS=1.0

# Simulated trading fee, in basis points of notional value, applied on both
# the opening and closing leg of a trade.
PAPER_FEE_BPS=1.0
