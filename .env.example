# Copy this file to .env and fill in real values.
# Never commit .env — it is already in .gitignore.

# --- AI reasoning provider (Anthropic) ---
ANTHROPIC_API_KEY=

# Model identifier only — changing models must never require code changes.
# See docs/DECISIONS.md for why this default was chosen and how to change it.
ANTHROPIC_MODEL=claude-opus-5

# Reasoning depth, kept independent from the model identifier.
# One of: low, medium, high, xhigh, max
ANTHROPIC_EFFORT=medium

# --- Market data provider (Twelve Data) ---
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# --- Decision memory (local SQLite, no external DB in this milestone) ---
ORION_DB_PATH=./orion.db

# --- Risk Guardian ---
# Fail-safe default: engaged (blocking). An absent or misconfigured switch
# must never silently permit trading — set to "disengaged" only deliberately.
# One of: engaged, disengaged
ORION_KILL_SWITCH=engaged

# How many bars old Evidence may be before the Risk Guardian vetoes on
# staleness (re-checked after the reasoning round-trip, independent of the
# staleness check already done at data-fetch time). Shares its default with
# orion.data.validation's own staleness threshold.
ORION_MAX_STALENESS_BARS=3.0

# How many bars old a ProposedDecision itself may be before the Risk Guardian
# treats it as expired — distinct from evidence staleness above.
ORION_MAX_DECISION_AGE_BARS=1.0

# Minimum acceptable risk/reward ratio for a trade proposal. 1.0 is a
# mathematically justified floor (below it, breakeven needs a win rate over
# 50%), not an empirically validated trading-strategy parameter — raising it
# requires real historical validation, not just a stated preference.
ORION_MIN_RISK_REWARD=1.0

# Off by default: the ATR% volatility thresholds in orion.analysis.structure
# are documented as uncalibrated placeholders, so blocking HIGH volatility by
# default would veto most higher-timeframe proposals using a number nobody
# calibrated. Set true only as a deliberate, recorded policy choice.
ORION_BLOCK_HIGH_VOLATILITY=false
